generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Mandant: eigene Firmendaten, erscheinen auf allen Belegen
model Company {
  id              Int     @id @default(1)
  name            String
  street          String  @default("")
  zip             String  @default("")
  city            String  @default("")
  country         String  @default("DE")
  email           String  @default("")
  phone           String  @default("")
  taxNumber       String  @default("")
  vatId           String  @default("")
  iban            String  @default("")
  bic             String  @default("")
  bankName        String  @default("")
  smallBusiness   Boolean @default(false) // Kleinunternehmer nach §19 UStG
  defaultTimeToPay Int    @default(14)
  chartOfAccounts String  @default("skr03") // skr03 oder skr04
  cashAccounting  Boolean @default(true)    // Ist-Versteuerung (true) oder Soll-Versteuerung
  vatPeriod       String  @default("QUARTER") // MONTH, QUARTER, YEAR
  datevAdvisor    String  @default("")      // DATEV-Beraternummer
  datevClient     String  @default("")      // DATEV-Mandantennummer
  fiscalYearStart Int     @default(1)       // Monat, in dem das Wirtschaftsjahr beginnt
}

// Nummernkreise je Belegart, z. B. RE-{YYYY}-{NNNN}
model NumberSequence {
  type    String @id // CUSTOMER, INVOICE, ORDER, CREDIT_NOTE
  format  String
  next    Int    @default(1)
}

model Contact {
  id               Int              @id @default(autoincrement())
  customerNumber   String           @unique
  // Organisation, wenn name gesetzt ist, sonst Person
  name             String?
  firstName        String?
  lastName         String?
  category         String           @default("CUSTOMER") // CUSTOMER, SUPPLIER, PARTNER
  status           Int              @default(1000)       // 100 Lead, 500 Ausstehend, 1000 Aktiv
  email            String           @default("")
  phone            String           @default("")
  vatId            String           @default("")
  taxNumber        String           @default("")
  iban             String           @default("")
  buyerReference   String           @default("")        // Leitweg-ID für E-Rechnungen an Behörden
  defaultTimeToPay Int?
  defaultDiscount  Float            @default(0)
  taxType          String           @default("default")
  note             String           @default("")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  addresses        ContactAddress[]
  invoices         Invoice[]
  orders           Order[]
  vouchers         Voucher[]
}

model ContactAddress {
  id        Int     @id @default(autoincrement())
  contactId Int
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind      String  @default("BILLING") // BILLING, DELIVERY
  street    String  @default("")
  zip       String  @default("")
  city      String  @default("")
  country   String  @default("DE")
}

model Unit {
  id    Int    @id @default(autoincrement())
  name  String @unique // Stk, Std, Tag, Pauschal, km
  parts Part[]
}

model Part {
  id         Int      @id @default(autoincrement())
  partNumber String   @unique
  name       String
  text       String   @default("")
  unitId     Int
  unit       Unit     @relation(fields: [unitId], references: [id])
  priceNet   Int      // Cent
  pricePurchase Int   @default(0)
  taxRate    Float    @default(19)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Invoice {
  id             Int        @id @default(autoincrement())
  // Nummer wird erst beim Abschließen vergeben (Entwürfe haben keine)
  invoiceNumber  String?    @unique
  type           String     @default("RE") // RE, SR (Storno), GU (Gutschrift), MA (Mahnung), AR, TR, ER
  status         Int        @default(100)  // 100 Entwurf, 200 Offen, 750 Teilbezahlt, 1000 Bezahlt
  contactId      Int
  contact        Contact    @relation(fields: [contactId], references: [id])
  address        String     // Empfängeradresse als Text, eingefroren beim Abschließen
  invoiceDate    DateTime
  deliveryDate   DateTime?
  deliveryDateUntil DateTime?
  timeToPay      Int        @default(14)
  header         String     @default("Rechnung")
  headText       String     @default("")
  footText       String     @default("")
  taxType        String     @default("default") // default, eu, noteu, ss
  currency       String     @default("EUR")
  showNet        Boolean    @default(true)
  discount       Float      @default(0)
  customerReference String  @default("")
  sumNet         Int        @default(0)
  sumTax         Int        @default(0)
  sumGross       Int        @default(0)
  paidAmount     Int        @default(0)
  dunningLevel   Int        @default(0)
  sentAt         DateTime?
  enshrinedAt    DateTime?  // festgeschrieben, danach unveränderbar (GoBD)
  // Bezug: Gutschrift oder Mahnung zur Ursprungsrechnung
  parentId       Int?
  parent         Invoice?   @relation("Bezug", fields: [parentId], references: [id])
  children       Invoice[]  @relation("Bezug")
  orderId        Int?
  order          Order?     @relation(fields: [orderId], references: [id])
  eInvoice       Boolean    @default(false)
  cancelsId      Int?       @unique
  cancels        Invoice?   @relation("Storno", fields: [cancelsId], references: [id])
  cancelledBy    Invoice?   @relation("Storno")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  positions      InvoicePosition[]
  payments       Payment[]
}

model InvoicePosition {
  id         Int     @id @default(autoincrement())
  invoiceId  Int
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position   Int
  partId     Int?
  name       String
  text       String  @default("")
  quantity   Float
  unit       String  @default("Stk")
  priceNet   Int     // Cent pro Einheit
  discount   Float   @default(0) // Prozent
  taxRate    Float
}

// Zahlung zu einer Rechnung oder einem Beleg, optional aus einem Bankumsatz
model Payment {
  id            Int          @id @default(autoincrement())
  invoiceId     Int?
  invoice       Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  voucherId     Int?
  voucher       Voucher?     @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  transactionId Int?
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  accountId     Int?         // Zahlungskonto bei manueller Buchung
  date          DateTime
  amount        Int          // Cent, immer positiv
  note          String       @default("")
  createdAt     DateTime     @default(now())
}

// Buchungskategorie mit Konten nach SKR03 und SKR04
model AccountingType {
  id             Int     @id @default(autoincrement())
  name           String
  kind           String  // EXPENSE, REVENUE, ASSET, PRIVATE
  skr03          String
  skr04          String
  defaultTaxRate Float   @default(19)
  active         Boolean @default(true)
  positions      VoucherPosition[]
  assets         Asset[]
}

// Beleg: Eingangsrechnung, Quittung oder sonstige Einnahme
model Voucher {
  id            Int       @id @default(autoincrement())
  creditDebit   String    @default("D") // D Ausgabe, C Einnahme
  status        Int       @default(50)  // 50 Entwurf, 100 Offen, 750 Teilbezahlt, 1000 Bezahlt
  supplierId    Int?
  supplier      Contact?  @relation(fields: [supplierId], references: [id])
  supplierName  String    @default("")
  documentNumber String   @default("") // Rechnungsnummer des Lieferanten
  voucherDate   DateTime
  deliveryDate  DateTime?
  dueDate       DateTime?
  // Steuerregel: default (Vorsteuer abziehbar bzw. umsatzsteuerpflichtig), novst (ohne Vorsteuerabzug),
  // igerwerb (innergemeinschaftlicher Erwerb), rc13b (Reverse Charge §13b), eu/noteu (steuerfreie Einnahmen)
  taxType       String    @default("default")
  net           Boolean   @default(false) // alle Positionen netto (true) oder brutto erfasst
  supplierIban  String    @default("")
  description   String    @default("")
  sumNet        Int       @default(0)
  sumTax        Int       @default(0)
  sumGross      Int       @default(0)
  paidAmount    Int       @default(0)
  fileName      String?
  filePath      String?
  fileType      String?
  fileHash      String?   // SHA-256 für die Dublettenprüfung
  enshrinedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  positions     VoucherPosition[]
  payments      Payment[]
  assets        Asset[]
}

model VoucherPosition {
  id               Int            @id @default(autoincrement())
  voucherId        Int
  voucher          Voucher        @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountingTypeId Int
  accountingType   AccountingType @relation(fields: [accountingTypeId], references: [id])
  taxRate          Float
  net              Boolean        @default(false) // true: Betrag ist netto, sonst brutto
  amount           Int            // Cent
  sumNet           Int            @default(0)
  sumTax           Int            @default(0)
  sumGross         Int            @default(0)
  comment          String         @default("")
  isAsset          Boolean        @default(false)
}

// Zahlungskonto: Bankkonto, Kasse oder Importkonto
model BankAccount {
  id             Int           @id @default(autoincrement())
  name           String
  type           String        @default("BANK") // BANK, CASH
  iban           String        @default("")
  bic            String        @default("")
  openingBalance Int           @default(0)
  openingDate    DateTime      @default(now())
  ledgerAccount  String        @default("1200") // SKR03 Bank 1200, Kasse 1000
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
}

model Transaction {
  id          Int         @id @default(autoincrement())
  accountId   Int
  account     BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  valueDate   DateTime
  entryDate   DateTime    @default(now())
  amount      Int         // Cent, Eingang positiv, Ausgang negativ
  payeeName   String      @default("")
  payeeIban   String      @default("")
  purpose     String      @default("")
  status      Int         @default(100) // 100 Offen, 200 Zugeordnet, 300 Privat, 400 Ohne Beleg gebucht
  importHash  String?     @unique
  createdAt   DateTime    @default(now())
  payments    Payment[]
}

// Angebot (AN), Auftragsbestätigung (AB) oder Lieferschein (LI)
model Order {
  id             Int       @id @default(autoincrement())
  orderNumber    String?   @unique
  type           String    @default("AN")
  status         Int       @default(100) // 100 Entwurf, 200 Versendet, 300 Abgelehnt, 500 Angenommen, 1000 Berechnet
  contactId      Int
  contact        Contact   @relation(fields: [contactId], references: [id])
  address        String
  orderDate      DateTime
  validUntil     DateTime?
  header         String    @default("Angebot")
  headText       String    @default("")
  footText       String    @default("")
  taxType        String    @default("default")
  currency       String    @default("EUR")
  discount       Float     @default(0)
  customerReference String @default("")
  sumNet         Int       @default(0)
  sumTax         Int       @default(0)
  sumGross       Int       @default(0)
  sentAt         DateTime?
  parentId       Int?
  parent         Order?    @relation("Folgebeleg", fields: [parentId], references: [id])
  children       Order[]   @relation("Folgebeleg")
  invoices       Invoice[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  positions      OrderPosition[]
}

model OrderPosition {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  position  Int
  partId    Int?
  name      String
  text      String  @default("")
  quantity  Float
  unit      String  @default("Stk")
  priceNet  Int
  discount  Float   @default(0)
  taxRate   Float
  optional  Boolean @default(false) // Optionale Position, zählt nicht zur Summe
}

// Regel, nach der importierte Umsätze automatisch als privat markiert werden
model PrivateRule {
  id         Int      @id @default(autoincrement())
  payeeName  String   @default("") // Teilstring, Groß-/Kleinschreibung egal
  purpose    String   @default("")
  createdAt  DateTime @default(now())
}

// Protokoll der DATEV-Exporte
model DatevExport {
  id        Int      @id @default(autoincrement())
  from      DateTime
  to        DateTime
  lines     Int
  enshrined Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Anlagegut für das Anlagenverzeichnis und die Abschreibung (AfA)
model Asset {
  id                Int            @id @default(autoincrement())
  name              String
  inventoryNumber   String         @default("")
  accountingTypeId  Int
  accountingType    AccountingType @relation(fields: [accountingTypeId], references: [id])
  method            String         @default("linear") // linear, digital (1 Jahr), gwg (sofort), pool (Sammelposten, 5 Jahre)
  acquisitionDate   DateTime
  cost              Int            // Anschaffungskosten in Cent (netto, ohne Vorsteuerabzug brutto)
  usefulLifeYears   Int            @default(1)
  voucherId         Int?
  voucher           Voucher?       @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherPositionId Int?           @unique
  disposalDate      DateTime?
  disposalProceeds  Int            @default(0) // Verkaufserlös netto in Cent
  note              String         @default("")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

// Benutzer mit Zugang zur Anwendung
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String   @default("")
  passwordHash String
  // Wird beim Passwortwechsel erhöht und macht bestehende Sitzungen ungültig
  sessionVersion Int    @default(1)
  createdAt    DateTime @default(now())
}

// Vorlage für den E-Mail-Versand je Belegart
model MailTemplate {
  docType String @id // INVOICE, ORDER, CREDIT_NOTE, DUNNING
  subject String
  body    String
}

// Protokoll versendeter E-Mails
model MailLog {
  id        Int      @id @default(autoincrement())
  docType   String   // invoice, order
  docId     Int
  to        String
  cc        String   @default("")
  subject   String
  messageId String   @default("")
  testMode  Boolean  @default(false)
  sentBy    String   @default("")
  createdAt DateTime @default(now())
}
